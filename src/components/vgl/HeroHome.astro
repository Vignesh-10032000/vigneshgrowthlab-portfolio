---
import { Icon } from 'astro-icon/components';

import WhatsAppCta from '~/components/vgl/WhatsAppCta.astro';

/**
 * Approved 2.5D hero — variant 1a "Floating Business Ecosystem"
 * (Hero Explorations.dc.html, applied in Home.dc.html): CSS-perspective
 * tilted tiles orbiting the brand mark, connector lines that draw in on
 * load, ±5px float loops. Mobile keeps browser + WhatsApp + brand only,
 * floats off. Reduced motion: fully static.
 */
---

<section class="vgl-hero vgl-container">
  <div class="vgl-hero-grid">
    <div>
      <h1 data-reveal>
        <span>Websites, POS&nbsp;&amp;</span>
        <span>WhatsApp automation</span>
        <span class="vgl-hero-accent">for Tamil Nadu businesses.</span>
      </h1>
      <p data-reveal class="vgl-hero-sub" style="transition-delay: 0.08s">
        Vignesh Growth Lab builds fast, conversion-focused websites, custom software, retail POS systems and WhatsApp AI
        workflows for gyms, boutiques and retail stores. Average delivery around 2 weeks — and you own 100% of it.
      </p>
      <div data-reveal class="vgl-hero-ctas" style="transition-delay: 0.16s">
        <WhatsAppCta label="Talk to Vignesh on WhatsApp" iconSize={19} class="vgl-hero-wa" />
        <a class="vgl-btn vgl-btn-ghost vgl-cta vgl-hero-work" href="#projects">
          View our work
          <Icon name="ph:arrow-down" class="vgl-arrow" style="font-size: 16px" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div id="vgl-hero-viz" data-reveal aria-hidden="true" style="transition-delay: 0.2s">
      <div class="vgl-viz-bloom"></div>
      <svg class="vgl-lines" viewBox="0 0 500 430" preserveAspectRatio="none">
        <path
          d="M250 92 C 250 150, 160 150, 126 188"
          style="stroke: color-mix(in srgb, var(--color-vgl-accent) 45%, transparent)"></path>
        <path
          d="M250 92 C 250 160, 350 150, 376 192"
          style="stroke: color-mix(in srgb, var(--color-vgl-cyan) 45%, transparent)"></path>
        <path
          d="M370 268 C 340 320, 230 316, 190 330"
          class="vgl-line-desktop"
          style="stroke: color-mix(in srgb, var(--color-vgl-wa) 40%, transparent)"></path>
      </svg>

      <div class="vgl-float vgl-viz-brand">
        <div>
          <img src="/brand/vgl-logo-mark.svg" alt="" width="32" height="32" style="border-radius: 8px" />
        </div>
      </div>

      <div class="vgl-float vgl-viz-browser">
        <div class="vgl-viz-browser-card">
          <div class="vgl-viz-chrome">
            <span></span><span></span><span></span>
            <span class="vgl-viz-address"></span>
          </div>
          <div class="vgl-viz-browser-body">
            <span class="vgl-viz-kicker-row">
              <span></span>
              <span></span>
            </span>
            <span style="width: 84%; height: 11px; border-radius: 5px; background: var(--color-vgl-neutral-300)"></span>
            <span style="width: 62%; height: 11px; border-radius: 5px; background: var(--color-vgl-neutral-500)"></span>
            <span style="width: 90%; height: 6px; border-radius: 3px; background: var(--color-vgl-neutral-700)"></span>
            <span style="width: 74%; height: 6px; border-radius: 3px; background: var(--color-vgl-neutral-700)"></span>
            <div class="vgl-viz-browser-foot">
              <span class="vgl-viz-pill"></span>
              <span class="vgl-viz-bars">
                <span style="height: 8px; background: color-mix(in srgb, var(--color-vgl-cyan) 55%, transparent)"
                ></span>
                <span style="height: 13px; background: color-mix(in srgb, var(--color-vgl-cyan) 70%, transparent)"
                ></span>
                <span style="height: 19px; background: var(--color-vgl-cyan)"></span>
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="vgl-float vgl-viz-pos vgl-viz-desktop">
        <div class="vgl-viz-pos-card">
          <span class="vgl-viz-pos-label">POS · Billing</span>
          <span class="vgl-viz-pos-row"
            ><span style="width: 44%"></span><span style="width: 22%; background: var(--color-vgl-neutral-500)"
            ></span></span
          >
          <span class="vgl-viz-pos-row"
            ><span style="width: 56%"></span><span style="width: 18%; background: var(--color-vgl-neutral-500)"
            ></span></span
          >
          <span class="vgl-viz-pos-total">
            <span>TOTAL</span>
            <span class="vgl-viz-pos-amount"></span>
          </span>
          <span class="vgl-viz-pos-sync">
            <span></span>
            Stock synced
          </span>
        </div>
      </div>

      <div class="vgl-float vgl-viz-node vgl-viz-desktop">
        <div>
          <span class="vgl-viz-node-dot" style="background: var(--color-vgl-accent)"></span>
          <span class="vgl-viz-node-line"></span>
          <span class="vgl-viz-node-dot" style="background: var(--color-vgl-cyan)"></span>
          <span class="vgl-viz-node-line"></span>
          <Icon name="ph:grid-four" style="font-size: 14px; color: var(--color-vgl-neutral-300)" />
        </div>
      </div>

      <div class="vgl-float vgl-viz-chat">
        <div class="vgl-viz-chat-card">
          <span class="vgl-viz-chat-head">
            <Icon name="ph:whatsapp-logo" style="font-size: 12px" />
            WhatsApp
          </span>
          <span class="vgl-viz-msg-in">Hi! Is this available?</span>
          <span class="vgl-viz-msg-out">Yes! Sending details now ✓</span>
          <span class="vgl-viz-chat-input"></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .vgl-hero {
    padding-top: clamp(48px, 7vw, 96px);
    /* The viz bloom extends -8% beyond its box; clip without creating a scroll container */
    overflow-x: clip;
  }

  .vgl-hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 52px clamp(28px, 4vw, 56px);
    align-items: center;
  }

  h1 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: clamp(36px, 5vw, 68px);
    line-height: 1.08;
    letter-spacing: -0.015em;
    margin: 0 0 0 -0.06em;
  }

  h1 > span {
    display: block;
  }

  .vgl-hero-accent {
    color: var(--color-vgl-accent-300);
  }

  .vgl-hero-sub {
    font-size: 17px;
    line-height: 1.65;
    max-width: 58ch;
    margin: 28px 0 0;
    color: var(--color-vgl-neutral-200);
  }

  .vgl-hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 28px;
  }

  .vgl-hero :global(.vgl-hero-wa),
  .vgl-hero-work {
    min-height: 46px;
    padding-inline: 20px;
  }

  /* ——— Visual composition ——— */

  #vgl-hero-viz {
    position: relative;
    width: 100%;
    max-width: 500px;
    height: clamp(320px, 38vw, 430px);
    justify-self: center;
  }

  .vgl-viz-bloom {
    position: absolute;
    inset: -8%;
    background: radial-gradient(
      60% 55% at 50% 42%,
      color-mix(in srgb, var(--color-vgl-accent-900) 55%, transparent),
      transparent 75%
    );
  }

  .vgl-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .vgl-lines path {
    stroke-width: 1.2;
    fill: none;
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
  }

  :global(#vgl-hero-viz.vgl-in) .vgl-lines path {
    animation: vgl-dash 1.1s ease forwards 0.45s;
  }

  :global(#vgl-hero-viz.vgl-in) .vgl-lines path:nth-child(2) {
    animation-delay: 0.7s;
  }

  :global(#vgl-hero-viz.vgl-in) .vgl-lines path:nth-child(3) {
    animation-delay: 0.95s;
  }

  @keyframes vgl-dash {
    to {
      stroke-dashoffset: 0;
    }
  }

  .vgl-viz-brand {
    position: absolute;
    top: 16px;
    left: 50%;
    margin-left: -27px;
    animation-delay: -1s;
  }

  .vgl-viz-brand > div {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-vgl-neutral-900) 85%, var(--color-vgl-bg));
    border: 1px solid var(--color-vgl-accent-700);
    box-shadow: 0 8px 30px color-mix(in srgb, var(--color-vgl-accent-900) 80%, transparent);
  }

  .vgl-viz-browser {
    position: absolute;
    top: 118px;
    left: 0;
    width: 60%;
    animation-delay: -3s;
  }

  .vgl-viz-browser-card {
    transform: perspective(1200px) rotateY(6deg) rotateX(3deg);
    border: 1px solid var(--color-vgl-neutral-600);
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-vgl-neutral-900) 90%, var(--color-vgl-bg));
    box-shadow: var(--shadow-vgl-lg);
    overflow: hidden;
  }

  .vgl-viz-chrome {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--color-vgl-neutral-800);
  }

  .vgl-viz-chrome > span:not(.vgl-viz-address) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-vgl-neutral-600);
  }

  .vgl-viz-address {
    flex: 1;
    height: 10px;
    margin-left: 6px;
    border-radius: 5px;
    background: var(--color-vgl-neutral-800);
  }

  .vgl-viz-browser-body {
    padding: 14px 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .vgl-viz-kicker-row {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .vgl-viz-kicker-row > span:first-child {
    width: 22px;
    height: 2px;
    background: var(--color-vgl-accent);
  }

  .vgl-viz-kicker-row > span:last-child {
    width: 38px;
    height: 6px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-vgl-accent) 45%, transparent);
  }

  .vgl-viz-browser-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 4px;
  }

  .vgl-viz-pill {
    width: 64px;
    height: 18px;
    border-radius: 9px;
    border: 1px solid var(--color-vgl-wa);
    background: rgba(37, 211, 102, 0.12);
  }

  .vgl-viz-bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
  }

  .vgl-viz-bars > span {
    width: 6px;
    border-radius: 2px;
  }

  .vgl-viz-pos {
    position: absolute;
    top: 150px;
    right: 0;
    width: 37%;
    animation-delay: -5s;
  }

  .vgl-viz-pos-card {
    transform: perspective(1200px) rotateY(-7deg) rotateX(3deg);
    border: 1px solid var(--color-vgl-neutral-600);
    border-radius: 11px;
    background: color-mix(in srgb, var(--color-vgl-neutral-900) 90%, var(--color-vgl-bg));
    box-shadow: var(--shadow-vgl-md);
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .vgl-viz-pos-label {
    font-size: 8.5px;
    letter-spacing: 0.12em;
    color: var(--color-vgl-cyan);
    text-transform: uppercase;
  }

  .vgl-viz-pos-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .vgl-viz-pos-row > span {
    height: 6px;
    border-radius: 3px;
    background: var(--color-vgl-neutral-600);
  }

  .vgl-viz-pos-total {
    border-top: 1px dashed var(--color-vgl-neutral-600);
    margin-top: 2px;
    padding-top: 7px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 8.5px;
    letter-spacing: 0.08em;
    color: var(--color-vgl-neutral-300);
  }

  .vgl-viz-pos-amount {
    width: 30%;
    height: 8px;
    border-radius: 4px;
    background: var(--color-vgl-accent-300);
  }

  .vgl-viz-pos-sync {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 8px;
    color: var(--color-vgl-neutral-400);
  }

  .vgl-viz-pos-sync > span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-vgl-cyan);
  }

  .vgl-viz-node {
    position: absolute;
    right: 6%;
    bottom: 14px;
    animation-delay: -2s;
  }

  .vgl-viz-node > div {
    display: flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--color-vgl-neutral-600);
    border-radius: 10px;
    background: color-mix(in srgb, var(--color-vgl-neutral-900) 90%, var(--color-vgl-bg));
    box-shadow: var(--shadow-vgl-sm);
    padding: 9px 12px;
  }

  .vgl-viz-node-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .vgl-viz-node-line {
    width: 16px;
    height: 1px;
    background: var(--color-vgl-neutral-500);
  }

  .vgl-viz-chat {
    position: absolute;
    left: 4%;
    bottom: 0;
    width: 47%;
    animation-delay: -6.5s;
  }

  .vgl-viz-chat-card {
    transform: perspective(1200px) rotateY(5deg);
    border: 1px solid var(--color-vgl-neutral-600);
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-vgl-neutral-900) 90%, var(--color-vgl-bg));
    box-shadow: var(--shadow-vgl-md);
    padding: 11px;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .vgl-viz-chat-head {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 8.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-vgl-wa-text);
  }

  .vgl-viz-msg-in {
    align-self: flex-start;
    max-width: 86%;
    padding: 5px 8px;
    border-radius: 9px 9px 9px 3px;
    background: var(--color-vgl-neutral-800);
    font-size: 9.5px;
    line-height: 1.4;
    color: var(--color-vgl-neutral-200);
  }

  .vgl-viz-msg-out {
    align-self: flex-end;
    max-width: 86%;
    padding: 5px 8px;
    border-radius: 9px 9px 3px 9px;
    background: color-mix(in srgb, var(--color-vgl-wa) 22%, var(--color-vgl-neutral-900));
    font-size: 9.5px;
    line-height: 1.4;
    color: var(--color-vgl-text);
  }

  .vgl-viz-chat-input {
    height: 9px;
    border-radius: 5px;
    border: 1px solid var(--color-vgl-neutral-700);
  }

  /* Mobile: browser + WhatsApp + brand only, floats off (design 1a note) */
  @media (max-width: 760px) {
    .vgl-viz-desktop,
    .vgl-line-desktop {
      display: none;
    }
    #vgl-hero-viz :global(.vgl-float) {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vgl-lines path,
    :global(#vgl-hero-viz.vgl-in) .vgl-lines path {
      stroke-dashoffset: 0;
      animation: none;
    }
    .vgl-viz-browser-card,
    .vgl-viz-pos-card,
    .vgl-viz-chat-card {
      transform: none;
    }
  }
</style>
