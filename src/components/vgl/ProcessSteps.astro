---
import type { ProcessStep } from '~/data/vgl/site';

export interface Props {
  steps: ProcessStep[];
}

const { steps } = Astro.props;
---

<div class="vgl-process-grid">
  {
    steps.map((step) => (
      <div class="vgl-process-step">
        <p class="vgl-process-num" style="font-feature-settings: 'tnum' 1">
          {step.number}
        </p>
        <h3>{step.title}</h3>
        <p class="vgl-process-copy">{step.copy}</p>
      </div>
    ))
  }
</div>

<style>
  .vgl-process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 14px;
    margin-top: 36px;
  }

  .vgl-process-step {
    padding: 24px;
    border: 1px solid var(--color-vgl-neutral-700);
    border-radius: var(--radius-vgl-md);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .vgl-process-num {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 14px;
    color: var(--color-vgl-accent);
    margin: 0;
  }

  .vgl-process-step h3 {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 17.5px;
    margin: 0;
  }

  .vgl-process-copy {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-vgl-neutral-300);
  }
</style>
