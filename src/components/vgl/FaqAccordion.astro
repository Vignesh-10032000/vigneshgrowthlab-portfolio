---
import { Icon } from 'astro-icon/components';

import { FAQS } from '~/data/vgl/site';
---

<div class="vgl-faq">
  {
    FAQS.map((faq, i) => (
      <details open={i === 0}>
        <summary>
          {faq.question}
          <Icon name="ph:plus" class="vgl-faq-ic" style="font-size: 18px" aria-hidden="true" />
        </summary>
        <p>{faq.answer}</p>
      </details>
    ))
  }
</div>

<style>
  details {
    border-top: 1px solid var(--color-vgl-neutral-700);
    padding: 4px 0;
  }

  details:last-child {
    border-bottom: 1px solid var(--color-vgl-neutral-700);
  }

  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 16.5px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--color-vgl-accent-200);
  }

  .vgl-faq :global(.vgl-faq-ic) {
    color: var(--color-vgl-accent);
    flex-shrink: 0;
    transition: transform 0.25s;
  }

  details[open] :global(.vgl-faq-ic) {
    transform: rotate(45deg);
  }

  details > p {
    margin: 0 0 20px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-vgl-neutral-300);
    max-width: 64ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .vgl-faq :global(.vgl-faq-ic) {
      transition: none;
    }
  }
</style>
