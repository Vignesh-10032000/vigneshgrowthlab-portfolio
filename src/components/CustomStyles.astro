---
import '@fontsource-variable/inter';
---

<style is:inline>
  /*
   * VGL is a dark-only design (Nocturne system). The same values are set on
   * :root and .dark so first paint is correct with no theme flash.
   */
  :root,
  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: #9184d9;
    --aw-color-secondary: #796cbf;
    --aw-color-accent: #9184d9;

    --aw-color-text-heading: #e9e9ed;
    --aw-color-text-default: #e9e9ed;
    --aw-color-text-muted: #cfd3e5;
    --aw-color-bg-page: #161826;

    --aw-color-bg-page-dark: #161826;
  }
</style>
