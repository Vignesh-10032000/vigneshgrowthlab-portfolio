---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/vgl/Header.astro';
import Footer from '~/components/vgl/Footer.astro';
import FloatingWhatsApp from '~/components/vgl/FloatingWhatsApp.astro';

import type { MetaData } from '~/types';

export interface Props {
  metadata?: MetaData;
  /** Which nav item is the current page (aria-current). */
  active?: 'about' | 'services' | 'projects' | 'contact' | '';
  /** JSON-LD payload for this route (from ~/utils/structured-data). */
  structuredData?: string;
}

const { metadata, active = '', structuredData } = Astro.props;
---

<Layout metadata={metadata}>
  <Header active={active} />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <FloatingWhatsApp />
  {structuredData && <script type="application/ld+json" set:html={structuredData} is:inline />}
</Layout>
