---
/**
 * Homepage — Phase 1 shell.
 * Phase 2 implements the full approved section order: Hero (2.5D), trust
 * strip, client testimonials, services overview, technologies, featured
 * projects, stats, comparison, founder credentials, process, FAQ, final CTA
 * + contact form.
 */
import PageLayout from '~/layouts/PageLayout.astro';
import WhatsAppCta from '~/components/vgl/WhatsAppCta.astro';

import { jsonLd, localBusiness, faqPage } from '~/utils/structured-data';

const metadata = {
  title: 'Vignesh Growth Lab — Websites, POS & WhatsApp Automation in Tamil Nadu',
  description:
    'Pollachi-based MSME building fast websites, custom software, retail POS and WhatsApp AI automation for Tamil Nadu businesses. 15+ projects delivered.',
};
---

<PageLayout metadata={metadata} structuredData={jsonLd(localBusiness(), faqPage())}>
  <section class="vgl-container" style="padding-block: clamp(48px, 7vw, 96px) clamp(56px, 7vw, 96px)">
    <h1
      style="font-family: var(--font-heading); font-weight: 500; font-size: clamp(36px, 5vw, 68px); line-height: 1.08; letter-spacing: -0.015em; margin: 0 0 0 -0.06em"
    >
      <span style="display: block">Websites, POS &</span>
      <span style="display: block">WhatsApp automation</span>
      <span style="display: block; color: var(--color-vgl-accent-300)">for Tamil Nadu businesses.</span>
    </h1>
    <p
      style="font-size: 17px; line-height: 1.65; max-width: 58ch; margin: 28px 0 0; color: var(--color-vgl-neutral-200)"
    >
      Vignesh Growth Lab builds fast, conversion-focused websites, custom software, retail POS systems and WhatsApp AI
      workflows for gyms, boutiques and retail stores. Average delivery around 2 weeks — and you own 100% of it.
    </p>
    <div style="display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px">
      <WhatsAppCta label="Talk to Vignesh on WhatsApp" iconSize={19} />
      <a class="vgl-btn vgl-btn-ghost" href="/projects">View our work</a>
    </div>
  </section>
</PageLayout>
