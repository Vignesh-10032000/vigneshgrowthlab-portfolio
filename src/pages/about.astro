---
/** About — Phase 1 shell. Phase 5 implements the full approved page. */
import PageLayout from '~/layouts/PageLayout.astro';
import SectionHeading from '~/components/vgl/SectionHeading.astro';
import WhatsAppCta from '~/components/vgl/WhatsAppCta.astro';

import { jsonLd, aboutPage } from '~/utils/structured-data';

const metadata = {
  title: 'About Vignesh Prabhu — Vignesh Growth Lab, Pollachi',
  description:
    'Vignesh Prabhu — AI Automation and Business Process Automation Specialist (MCA). MSME-registered business in Pollachi, Tamil Nadu. Direct founder support on every project.',
};
---

<PageLayout metadata={metadata} active="about" structuredData={jsonLd(aboutPage())}>
  <section class="vgl-container" style="padding-block: clamp(48px, 7vw, 88px)">
    <SectionHeading kicker="About" as="h1" title="One founder.<br />Every project." />
    <p
      style="font-size: 16.5px; line-height: 1.7; color: var(--color-vgl-neutral-200); max-width: 54ch; margin: 22px 0 0"
    >
      Vignesh Growth Lab is a Pollachi-based, MSME-registered business run by Vignesh Prabhu — AI Automation and
      Business Process Automation Specialist with an MCA from Dr. Mahalingam College of Engineering &amp; Technology.
    </p>
    <div style="display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px">
      <WhatsAppCta label="WhatsApp Vignesh" />
      <a class="vgl-btn vgl-btn-primary" href="/documents/vgl-resume.pdf" target="_blank" rel="noopener noreferrer">
        View Resume
      </a>
    </div>
  </section>
</PageLayout>
