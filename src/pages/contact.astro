---
/** Contact — Phase 1 shell. Phase 5 implements the full page incl. Formspree form. */
import { Icon } from 'astro-icon/components';

import PageLayout from '~/layouts/PageLayout.astro';
import SectionHeading from '~/components/vgl/SectionHeading.astro';
import WhatsAppCta from '~/components/vgl/WhatsAppCta.astro';

import { CONTACT } from '~/data/vgl/site';
import { jsonLd, contactPage } from '~/utils/structured-data';

const metadata = {
  title: 'Contact — Talk to Vignesh | Vignesh Growth Lab, Pollachi',
  description:
    'Contact Vignesh Growth Lab: WhatsApp +91 82200 34139, vigneshgrowthlab@gmail.com, Pollachi, Tamil Nadu. Vignesh personally replies within 24 hours.',
};
---

<PageLayout metadata={metadata} active="contact" structuredData={jsonLd(contactPage())}>
  <section class="vgl-container" style="padding-block: clamp(44px, 6vw, 80px) clamp(52px, 7vw, 88px)">
    <SectionHeading
      kicker="Contact"
      as="h1"
      title="Let's Discuss Your Project"
      sub="Fill this in 60 seconds. Vignesh personally replies within 24 hours."
    />
    <div style="display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px">
      <WhatsAppCta label="Chat on WhatsApp" iconSize={18} />
    </div>
    <div style="margin-top: 36px; display: flex; flex-direction: column; gap: 14px; font-size: 14.5px">
      <a
        href={CONTACT.phoneHref}
        style="display: flex; align-items: center; gap: 10px; color: var(--color-vgl-neutral-300); text-decoration: none"
      >
        <Icon name="ph:phone" style="font-size: 17px; color: var(--color-vgl-accent)" aria-hidden="true" />
        {CONTACT.phoneDisplay}
      </a>
      <a
        href={`mailto:${CONTACT.email}`}
        style="display: flex; align-items: center; gap: 10px; color: var(--color-vgl-neutral-300); text-decoration: none; word-break: break-all"
      >
        <Icon name="ph:envelope-simple" style="font-size: 17px; color: var(--color-vgl-accent)" aria-hidden="true" />
        {CONTACT.email}
      </a>
      <span style="display: flex; align-items: center; gap: 10px; color: var(--color-vgl-neutral-300)">
        <Icon name="ph:map-pin" style="font-size: 17px; color: var(--color-vgl-accent)" aria-hidden="true" />
        {CONTACT.location}
      </span>
    </div>
  </section>
</PageLayout>
